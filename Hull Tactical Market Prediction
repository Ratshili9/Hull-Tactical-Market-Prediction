    "\n",
    "# Alternative: Simple momentum strategy (often works well)\n",
    "class MomentumStrategy:\n",
    "    def __init__(self, train_data):\n",
    "        self.train_data = train_data.copy()\n",
    "        self.momentum_window = 63  # 3-month momentum\n",
    "        self.reversion_window = 5  # Week-based reversion\n",
    "        \n",
    "    def predict_allocation(self, test_df):\n",
    "        \"\"\"Simple but effective momentum + mean reversion\"\"\"\n",
    "        \n",
    "        # Get recent returns for momentum calculation\n",
    "        if len(self.train_data) >= self.momentum_window:\n",
    "            recent_returns = self.train_data['forward_returns'].iloc[-self.momentum_window:]\n",
    "            \n",
    "            # Momentum signal (3-month)\n",
    "            momentum = (1 + recent_returns).prod() - 1\n",
    "            \n",
    "            # Short-term mean reversion (1-week)\n",
    "            if len(self.train_data) >= self.reversion_window:\n",
    "                week_returns = self.train_data['forward_returns'].iloc[-self.reversion_window:]\n",
    "                reversion_signal = -week_returns.mean() * 10  # Mean reversion\n",
    "            else:\n",
    "                reversion_signal = 0\n",
    "                \n",
    "            # Combined signal\n",
    "            combined_signal = momentum * 3 + reversion_signal\n",
    "            \n",
    "            # Convert to allocation\n",
    "            allocation = 1.0 + np.tanh(combined_signal * 2)  # Conservative scaling\n",
    "            \n",
    "        else:\n",
    "            # Insufficient data - market weight\n",
    "            allocation = 1.0\n",
    "            \n",
    "        allocation = np.clip(allocation, MIN_POSITION, MAX_POSITION)\n",
    "        \n",
    "        print(f\"Momentum Strategy Allocation: {allocation:.4f}\")\n",
    "        return allocation\n"
