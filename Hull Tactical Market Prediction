    "class HighSharpePredictor:\n",
    "    def __init__(self, train_data):\n",
    "        self.train_data = train_data.copy()\n",
    "        self.model = None\n",
    "        self.scaler = StandardScaler()\n",
    "        self.volatility_lookback = 63  # 3 months for volatility estimation\n",
    "        self.momentum_lookback = 21    # 1 month momentum\n",
    "        self.reversion_lookback = 5    # Week-based mean reversion\n",
    "        self.current_regime = \"NEUTRAL\"\n",
    "        \n",
    "    def calculate_market_regime(self, data):\n",
    "        \"\"\"Detect current market regime for adaptive strategy\"\"\"\n",
    "        if len(data) < 252:\n",
    "            returns = data['forward_returns']\n",
    "        else:\n",
    "            returns = data['forward_returns'].iloc[-252:]\n",
    "            \n",
    "        # Calculate regime metrics\n",
    "        vol_1m = returns.iloc[-21:].std() * np.sqrt(252)\n",
    "        vol_1y = returns.std() * np.sqrt(252)\n",
    "        momentum = (1 + returns.iloc[-63:]).prod() - 1\n",
    "        \n",
    "        # Regime classification\n",
    "        if vol_1m > vol_1y * 1.3:\n",
    "            return \"HIGH_VOL\"\n",
    "        elif momentum > 0.15:\n",
    "            return \"BULL\"\n",
    "        elif momentum < -0.10:\n",
    "            return \"BEAR\"\n",
    "        else:\n",
    "            return \"NEUTRAL\"\n",
    "    \n",
    "    def select_predictive_features(self, data):\n",
    "        \"\"\"Select only the most predictive features to avoid overfitting\"\"\"\n",
    "        # Focus on features that have shown historical predictive power\n",
    "        high_priority = ['MOM', 'V', 'P']  # Momentum, Volatility, Price features\n",
    "        medium_priority = ['M', 'E']       # Market, Economic features\n",
    "        \n",
    "        selected_features = []\n",
    "        \n",
    "        # Add high priority features\n",
    "        for prefix in high_priority:\n",
    "            prefix_features = [col for col in data.columns if col.startswith(prefix)]\n",
    "            selected_features.extend(prefix_features[:3])  # Take top 3 of each type\n",
    "            \n",
    "        # Add medium priority features sparingly\n",
    "        for prefix in medium_priority:\n",
    "            prefix_features = [col for col in data.columns if col.startswith(prefix)]\n",
    "            selected_features.extend(prefix_features[:2])\n",
    "            \n",
    "        # Always include dummy variables (calendar effects)\n",
    "        dummy_features = [col for col in data.columns if col.startswith('D')]\n",
    "        selected_features.extend(dummy_features)\n",
    "        \n",
    "        return selected_features\n",
    "    \n",
    "    def create_robust_features(self, df):\n",
    "        \"\"\"Create robust, interpretable features that work well in finance\"\"\"\n",
    "        features_df = df.copy()\n",
    "        \n",
    "        # Use lagged returns for feature engineering to avoid lookahead\n",
    "        if 'lagged_forward_returns' in df.columns:\n",
    "            returns = df['lagged_forward_returns']\n",
    "        elif 'forward_returns' in df.columns:\n",
    "            returns = df['forward_returns']\n",
    "        else:\n",
    "            returns = pd.Series(0, index=df.index)\n",
    "        \n",
    "        # 1. MOMENTUM FEATURES (most important)\n",
    "        features_df['momentum_1m'] = returns.rolling(21).mean()\n",
    "        features_df['momentum_3m'] = returns.rolling(63).mean()\n",
    "        features_df['momentum_12m'] = returns.rolling(252).mean()\n",
    "        \n",
    "        # 2. MEAN REVERSION FEATURES\n",
    "        features_df['reversion_5d'] = -returns.rolling(5).mean()  # Negative for mean reversion\n",
    "        features_df['reversion_1m'] = -returns.rolling(21).mean()\n",
    "        \n",
    "        # 3. VOLATILITY REGIME FEATURES\n",
    "        features_df['volatility_1m'] = returns.rolling(21).std()\n",
    "        features_df['volatility_3m'] = returns.rolling(63).std()\n",
    "        features_df['vol_ratio'] = features_df['volatility_1m'] / (features_df['volatility_3m'] + 1e-8)\n",
    "        \n",
    "        # 4. RISK-ADJUSTED MOMENTUM\n",
    "        features_df['sharpe_1m'] = features_df['momentum_1m'] / (features_df['volatility_1m'] + 1e-8)\n",
    "        features_df['sharpe_3m'] = features_df['momentum_3m'] / (features_df['volatility_3m'] + 1e-8)\n",
    "        \n",
    "        # 5. EXTREME MOVEMENT DETECTION\n",
    "        features_df['z_score'] = (returns - returns.rolling(63).mean()) / (returns.rolling(63).std() + 1e-8)\n",
    "        features_df['extreme_down'] = (features_df['z_score'] < -2).astype(float)\n",
    "        features_df['extreme_up'] = (features_df['z_score'] > 2).astype(float)\n",
    "        \n",
    "        # Fill NaN values\n",
    "        features_df = features_df.fillna(method='ffill').fillna(0)\n",
    "        \n",
    "        return features_df\n",
    "    \n",
    "    def train_simple_model(self):\n",
    "        \"\"\"Train a simple but effective model\"\"\"\n",
    "        print(\"Training high-sharpe model...\")\n",
    "        \n",
    "        # Use substantial history but not too much (markets change)\n",
    "        lookback = min(1008, len(self.train_data))  # ~4 years\n",
    "        train_subset = self.train_data.iloc[-lookback:].copy()\n",
    "        \n",
    "        # Create features\n",
    "        feature_data = self.create_robust_features(train_subset)\n",
    "        selected_features = self.select_predictive_features(feature_data)\n",
    "        \n",
    "        # Ensure we have the features\n",
    "        available_features = [f for f in selected_features if f in feature_data.columns]\n",
    "        X = feature_data[available_features]\n",
    "        \n",
    "        # Target: next day's excess returns (shifted appropriately)\n",
    "        if 'market_forward_excess_returns' in train_subset.columns:\n",
    "            y = train_subset['market_forward_excess_returns'].values\n",
    "        else:\n",
    "            # Fallback: use raw returns\n",
    "            y = train_subset['forward_returns'].values\n",
    "        \n",
    "        # Remove NaN values\n",
    "        valid_idx = ~np.isnan(y) & ~X.isna().any(axis=1)\n",
    "        X = X[valid_idx]\n",
    "        y = y[valid_idx]\n",
    "        \n",
    "        if len(X) < 100:\n",
    "            print(\"Insufficient training data\")\n",
    "            self.model = None\n",
    "            return\n",
    "        \n",
    "        # Scale features\n",
    "        X_scaled = self.scaler.fit_transform(X)\n",
    "        \n",
    "        # Use Ridge regression - stable and robust for finance\n",
    "        self.model = Ridge(alpha=1.0, random_state=42)\n",
    "        self.model.fit(X_scaled, y)\n",
    "        \n",
    "        # Store feature info\n",
    "        self.feature_columns = available_features\n",
    "        \n",
    "        print(f\"Trained on {len(X)} samples with {len(available_features)} features\")\n",
    "        print(f\"Market regime: {self.calculate_market_regime(self.train_data)}\")\n",
    "    \n",
    "    def predict_with_confidence(self, test_df):\n",
    "        \"\"\"Make prediction with confidence assessment\"\"\"\n",
    "        if self.model is None:\n",
    "            return 0.0, 0.0  # Neutral prediction\n",
    "        \n",
    "        try:\n",
    "            # Create features for current data\n",
    "            feature_data = self.create_robust_features(test_df)\n",
    "            \n",
    "            # Ensure we have required features\n",
    "            X = pd.DataFrame()\n",
    "            for feature in self.feature_columns:\n",
    "                if feature in feature_data.columns:\n",
    "                    X[feature] = feature_data[feature]\n",
    "                else:\n",
    "                    X[feature] = 0  # Fill missing with neutral value\n",
    "            \n",
    "            # Scale and predict\n",
    "            X_scaled = self.scaler.transform(X)\n",
    "            prediction = self.model.predict(X_scaled)[0]\n",
    "            \n",
    "            # Simple confidence based on recent prediction stability\n",
    "            confidence = 1.0\n",
    "            \n",
    "            return prediction, confidence\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"Prediction error: {e}\")\n",
    "            return 0.0, 0.0\n",
    "    \n",
    "    def calculate_optimal_allocation(self, predicted_return, confidence, market_regime):\n",
    "        \"\"\"Convert prediction to optimal allocation considering regime and constraints\"\"\"\n",
    "        \n",
    "        # Base signal strength (conservative scaling)\n",
    "        base_signal = predicted_return * 5.0  # More conservative scaling\n",
    "        \n",
    "        # Adjust for market regime\n",
    "        regime_multiplier = {\n",
    "            \"BULL\": 1.2,      # More aggressive in bull markets\n",
    "            \"BEAR\": 0.6,      # More conservative in bear markets  \n",
    "            \"HIGH_VOL\": 0.4,  # Very conservative in high vol\n",
    "            \"NEUTRAL\": 1.0    # Normal in neutral markets\n",
    "        }\n",
    "        \n",
    "        regime_adj = regime_multiplier.get(market_regime, 1.0)\n",
    "        \n",
    "        # Confidence adjustment\n",
    "        confidence_adj = 0.5 + (confidence * 0.5)  # 0.5 to 1.0\n",
    "        \n",
    "        # Combined signal\n",
    "        combined_signal = base_signal * regime_adj * confidence_adj\n",
    "        \n",
    "        # Convert to allocation (sigmoid-like but bounded)\n",
    "        # 0 signal = 100% allocation (market weight)\n",
    "        allocation = 1.0 + np.tanh(combined_signal)  # Range: 0 to 2\n",
    "        \n",
    "        # Ensure we're within bounds\n",
    "        allocation = np.clip(allocation, MIN_POSITION, MAX_POSITION)\n",
    "        \n",
    "        return allocation\n",
    "    \n",
    "    def predict_allocation(self, test_df):\n",
    "        \"\"\"Main prediction function\"\"\"\n",
    "        # Get market regime\n",
    "        market_regime = self.calculate_market_regime(self.train_data)\n",
    "        \n",
    "        # Make prediction\n",
    "        predicted_return, confidence = self.predict_with_confidence(test_df)\n",
    "        \n",
    "        # Calculate allocation\n",
    "        allocation = self.calculate_optimal_allocation(\n",
    "            predicted_return, confidence, market_regime\n",
    "        )\n",
    "        \n",
    "        print(f\"Regime: {market_regime}, Pred Return: {predicted_return:.4f}, Allocation: {allocation:.4f}\")\n",
    "        \n",
    "        return allocation"
