},{"cell_type":"code","source":"class SP500Predictor:\n    def __init__(self, train_data):\n        self.train_data = train_data.copy()\n        self.model = None\n        self.scaler = StandardScaler()\n        self.feature_columns = []\n        self.volatility_lookback = 20\n        self.market_volatility = self._calculate_market_volatility()\n        self.recent_predictions = []\n        \n    def _calculate_market_volatility(self):\n        \"\"\"Calculate annualized market volatility from training data\"\"\"\n        if len(self.train_data) < 252:\n            returns = self.train_data['forward_returns']\n        else:\n            returns = self.train_data['forward_returns'].iloc[-252:]\n        return returns.std() * np.sqrt(TRADING_DAYS_PER_YEAR)\n    \n    def _create_technical_features(self, df):\n        \"\"\"Create technical indicators from returns data\"\"\"\n        features_df = df.copy()\n        \n        if 'lagged_forward_returns' in df.columns:\n            returns = df['lagged_forward_returns']\n        elif 'forward_returns' in df.columns:\n            returns = df['forward_returns']\n        else:\n            return pd.DataFrame()\n            \n        # Momentum features\n        features_df['momentum_5'] = returns.rolling(5).mean()\n        features_df['momentum_10'] = returns.rolling(10).mean()\n        features_df['momentum_20'] = returns.rolling(20).mean()\n        \n        # Volatility features\n        features_df['volatility_5'] = returns.rolling(5).std()\n        features_df['volatility_20'] = returns.rolling(20).std()\n        features_df['volatility_ratio'] = features_df['volatility_5'] / (features_df['volatility_20'] + 1e-8)\n        \n        # Mean reversion features\n        features_df['z_score_10'] = (returns - returns.rolling(10).mean()) / (returns.rolling(10).std() + 1e-8)\n        features_df['z_score_20'] = (returns - returns.rolling(20).mean()) / (returns.rolling(20).std() + 1e-8)\n        \n        # Price position features\n        features_df['high_10'] = returns.rolling(10).max()\n        features_df['low_10'] = returns.rolling(10).min()\n        features_df['position_in_range'] = (returns - features_df['low_10']) / (features_df['high_10'] - features_df['low_10'] + 1e-8)\n        \n        # Trend features\n        features_df['trend_5'] = returns.rolling(5).apply(lambda x: np.polyfit(range(len(x)), x, 1)[0])\n        features_df['trend_10'] = returns.rolling(10).apply(lambda x: np.polyfit(range(len(x)), x, 1)[0])\n        \n        return features_df\n    \n    def _get_feature_columns(self):\n        \"\"\"Get all available feature columns from the dataset\"\"\"\n        feature_sets = ['M', 'E', 'I', 'P', 'V', 'S', 'MOM', 'D']\n        available_features = []\n        \n        for prefix in feature_sets:\n            prefix_features = [col for col in self.train_data.columns if col.startswith(prefix)]\n            available_features.extend(prefix_features)\n            \n        return available_features\n    \n    def prepare_features(self, df, is_training=True):\n        \"\"\"Prepare features for model training or prediction\"\"\"\n        df_copy = df.copy()\n        \n        # Get base features\n        base_features = self._get_feature_columns()\n        \n        # Create technical features if we have returns data\n        if 'forward_returns' in df.columns or 'lagged_forward_returns' in df.columns:\n            tech_features_df = self._create_technical_features(df_copy)\n            if not tech_features_df.empty:\n                tech_features = [col for col in tech_features_df.columns if col not in ['forward_returns', 'lagged_forward_returns']]\n                df_copy = pd.concat([df_copy, tech_features_df[tech_features]], axis=1)\n                base_features.extend(tech_features)\n        \n        # Select only numeric features and handle missing values\n        numeric_features = []\n        for feature in base_features:\n            if feature in df_copy.columns and pd.api.types.is_numeric_dtype(df_copy[feature]):\n                df_copy[feature] = df_copy[feature].fillna(method='ffill').fillna(0)\n                numeric_features.append(feature)\n        \n        if is_training:\n            self.feature_columns = numeric_features\n            \n        # Ensure we only use features that exist in the current dataframe\n        available_features = [f for f in self.feature_columns if f in df_copy.columns]\n        \n        return df_copy[available_features]\n    \n    def train(self):\n        \"\"\"Train the prediction model\"\"\"\n        print(\"Training SP500 prediction model...\")\n        \n        # Use recent data for training\n        if len(self.train_data) > TRAIN_WINDOW:\n            train_subset = self.train_data.iloc[-TRAIN_WINDOW:].copy()\n        else:\n            train_subset = self.train_data.copy()\n        \n        # Prepare features\n        X = self.prepare_features(train_subset, is_training=True)\n        y = train_subset['market_forward_excess_returns'].values\n        \n        # Remove rows with NaN targets\n        valid_indices = ~np.isnan(y)\n        X = X[valid_indices]\n        y = y[valid_indices]\n        \n        if len(X) == 0:\n            print(\"No valid training data available\")\n            return\n        \n        # Scale features\n        X_scaled = self.scaler.fit_transform(X)\n        \n        # Train ensemble model\n        self.model = GradientBoostingRegressor(\n            n_estimators=100,\n            learning_rate=0.1,\n            max_depth=6,\n            min_samples_split=20,\n            min_samples_leaf=10,\n            random_state=42\n        )\n        \n        self.model.fit(X_scaled, y)\n        print(f\"Model trained on {len(X)} samples with {X.shape[1]} features\")\n    \n    def predict_return(self, test_df):\n        \"\"\"Predict excess return for a single test row\"\"\"\n        if self.model is None:\n            return 0.0  # Neutral prediction if no model\n            \n        try:\n            # Prepare features\n            X = self.prepare_features(test_df, is_training=False)\n            \n            # Ensure we have the same features as training\n            missing_features = set(self.feature_columns) - set(X.columns)\n            for feature in missing_features:\n                X[feature] = 0\n                \n            X = X[self.feature_columns]\n            \n            # Scale and predict\n            X_scaled = self.scaler.transform(X)\n            prediction = self.model.predict(X_scaled)[0]\n            \n            return float(prediction)\n            \n        except Exception as e:\n            print(f\"Prediction error: {e}\")\n            return 0.0\n    \n    def calculate_volatility_adjustment(self, recent_volatility):\n        \"\"\"Calculate volatility adjustment to stay within constraints\"\"\"\n        if self.market_volatility == 0:\n            return 1.0\n            \n        current_vol_ratio = recent_volatility / self.market_volatility\n        \n        if current_vol_ratio > VOL_TARGET:\n            # Reduce position to control volatility\n            adjustment = VOL_TARGET / current_vol_ratio\n        else:\n            adjustment = 1.0\n            \n        return adjustment\n    \n    def predict_allocation(self, test_df):\n        \"\"\"Convert return prediction to allocation decision\"\"\"\n        # Get return prediction\n        predicted_return = self.predict_return(test_df)\n        \n        # Calculate recent volatility for adjustment\n        if 'lagged_forward_returns' in test_df.columns:\n            recent_returns = test_df['lagged_forward_returns'].dropna()\n            if len(recent_returns) >= self.volatility_lookback:\n                recent_vol = recent_returns.iloc[-self.volatility_lookback:].std() * np.sqrt(TRADING_DAYS_PER_YEAR)\n            else:\n                recent_vol = self.market_volatility\n        else:\n            recent_vol = self.market_volatility\n        \n        # Volatility adjustment\n        vol_adjustment = self.calculate_volatility_adjustment(recent_vol)\n        \n        # Convert return prediction to allocation (sigmoid-like transformation)\n        # Scale prediction to reasonable range\n        scaled_signal = np.tanh(predicted_return * 10)  # Scale factor of 10\n        \n        # Base allocation: 100% + signal\n        base_allocation = 1.0 + scaled_signal\n        \n        # Apply volatility adjustment\n        final_allocation = base_allocation * vol_adjustment\n        \n        # Clip to valid range\n        final_allocation = np.clip(final_allocation, MIN_POSITION, MAX_POSITION)\n        \n        self.recent_predictions.append({\n            'predicted_return': predicted_return,\n            'allocation': final_allocation,\n            'vol_adjustment': vol_adjustment\n        })\n        \n        return final_allocation\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-10-28T12:26:57.816061Z","iopub.execute_input":"2025-10-28T12:26:57.817189Z","iopub.status.idle":"2025-10-28T12:26:57.837813Z","shell.execute_reply.started":"2025-10-28T12:26:57.817157Z","shell.execute_reply":"2025-10-28T12:26:57.836824Z"}},"outputs":[],"execution_count":21},{"cell_type":"code","source":"def calculate_adjusted_sharpe(solution_df, predictions):\n    \"\"\"Calculate the competition's adjusted Sharpe ratio.\"\"\"\n    solution = solution_df.copy()\n    solution['position'] = predictions\n    \n    solution['strategy_returns'] = (\n        solution['risk_free_rate'] * (1 - solution['position']) +\n        solution['position'] * solution['forward_returns']\n    )\n    \n    strategy_excess = solution['strategy_returns'] - solution['risk_free_rate']\n    strategy_cum_excess = (1 + strategy_excess).prod()\n    \n    if strategy_cum_excess <= 0:\n        return -1000.0\n    \n    strategy_mean_excess = strategy_cum_excess ** (1 / len(solution)) - 1\n    strategy