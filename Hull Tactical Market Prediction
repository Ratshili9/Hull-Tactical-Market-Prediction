    "# Simple backtest to choose best strategy\n",
    "def quick_backtest(strategy, data, days=180):\n",
    "    \"\"\"Quick backtest to evaluate strategy\"\"\"\n",
    "    if len(data) < days + 100:\n",
    "        return 0.0\n",
    "        \n",
    "    test_data = data.iloc[-days:].copy()\n",
    "    predictions = []\n",
    "    \n",
    "    for i in range(len(test_data)):\n",
    "        current_data = test_data.iloc[i:i+1]\n",
    "        if hasattr(strategy, 'predict_allocation'):\n",
    "            allocation = strategy.predict_allocation(current_data)\n",
    "        else:\n",
    "            allocation = 1.0\n",
    "        predictions.append(allocation)\n",
    "    \n",
    "    # Simple Sharpe calculation (approximate)\n",
    "    strategy_returns = (\n",
    "        test_data['risk_free_rate'].values * (1 - np.array(predictions)) +\n",
    "        np.array(predictions) * test_data['forward_returns'].values\n",
    "    )\n",
    "    \n",
    "    excess_returns = strategy_returns - test_data['risk_free_rate'].values\n",
    "    sharpe = np.mean(excess_returns) / np.std(excess_returns) * np.sqrt(252)\n",
    "    \n",
    "    return sharpe if not np.isnan(sharpe) else 0.0"
